# .vscodeignore — everything listed here is EXCLUDED from the .vsix package.
# Anything NOT listed here ships to end users. Verify with: npx @vscode/vsce ls

# VCS & tooling
.git/**
.gitignore
.atl/**
.vscode/**

# Dependencies & lockfile
node_modules/**
pnpm-lock.yaml

# Source — only the compiled out/ folder ships
src/**
esbuild.js
tsconfig.json
out/**/*.map

# Maintainer & planning docs — not for end users
ANALYSIS.md
PUBLISHING.md
Requerimientos.md
SCREENSHOTS.md
SPEC.md
